# ── Node dependencies ─────────────────────────────────────────────────────────
# Always reinstalled inside the build stage from the lock file.
node_modules/

# ── Previous builds ───────────────────────────────────────────────────────────
dist/

# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Claude Code internals ─────────────────────────────────────────────────────
.claude/

# ── Local data and exports ────────────────────────────────────────────────────
PROSPECT_data/
Zipped Versions/
# Synthetic test fixtures — the app loads data via upload at runtime, never from
# bundled files, so these large xlsx don't belong in the build context or image.
test-data/

# ── Scratch / dev-only files (never needed to build the image) ────────────────
*.cjs
verify_state.json
CLAUDE.md
_archive/
"New capability merge/"

# ── Python / Streamlit artefacts ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
app.py
run_app.py
requirements.txt

# ── Editor and OS noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# ── Environment files ─────────────────────────────────────────────────────────
# Never bake secrets into the image — inject them at runtime via Cloud Run.
.env
.env.*

# Local-only Express dev server — never part of the production image.
server.ts
