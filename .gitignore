node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Archived versions — never needed in the repo
*.zip
/_archive/

# Synthetic test data — keep local, not in the shared repo
/test-data/*.xlsx

# Local forecast data, imports and exports — keep local, never in the shared repo
/PROSPECT_data/

# Build output and dependencies
/node_modules/
/dist/

# One-off verification and migration scratch scripts — run once, kept locally,
# never part of the build. They accumulate in the repo root and obscure genuinely
# unexpected changes in `git status`.
/verify_*.cjs
/verify_state.json
/*_scratch.cjs
/add_translations.cjs

# Agent worktrees — ephemeral local checkouts created per-agent for isolation.
# Machine-local and disposable; never meaningful to another clone.
.claude/worktrees/

# Local-only Express dev server. Untracked by request: production is served by
# nginx (see Dockerfile/nginx.conf) and must not ship a Node server. Run it
# locally with `npm run dev:express`.
/server.ts
